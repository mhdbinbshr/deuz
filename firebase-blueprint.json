{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "description": "User's full name" },
        "email": { "type": "string", "format": "email", "description": "User's email address" },
        "mobile": { "type": "string", "description": "User's mobile number" },
        "role": { "type": "string", "enum": ["user", "admin", "concierge"], "description": "User's role" },
        "createdAt": { "type": "timestamp", "description": "Creation timestamp" },
        "addresses": { "type": "array", "description": "User's saved addresses" }
      },
      "required": ["email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Product catalog item",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "details": { "type": "object" },
        "countInStock": { "type": "number" },
        "isArchived": { "type": "boolean" },
        "sizes": { "type": "array" },
        "gallery": { "type": "array" },
        "uniquenessTag": { "type": "string" },
        "imageTag": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["title", "price", "category", "image"]
    },
    "Cart": {
      "title": "Cart",
      "description": "User's shopping cart",
      "type": "object",
      "properties": {
        "user": { "type": "string", "description": "User ID" },
        "items": { "type": "array", "description": "Cart items" }
      },
      "required": ["user", "items"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order",
      "type": "object",
      "properties": {
        "user": { "type": "string", "description": "User ID (nullable for guests)" },
        "conciergeCode": { "type": "string" },
        "items": { "type": "array" },
        "shippingAddress": { "type": "object" },
        "totalAmount": { "type": "number" },
        "contactMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "orderStatus": { "type": "string" },
        "createdAt": { "type": "timestamp" },
        "statusHistory": { "type": "array" },
        "conversationStartedAt": { "type": "timestamp" },
        "internalNotes": { "type": "string" },
        "paymentLink": { "type": "string" },
        "paymentDetails": { "type": "object" }
      },
      "required": ["conciergeCode", "items", "shippingAddress", "totalAmount", "orderStatus"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Global system settings",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "conciergeConfig": { "type": "object" },
        "siteContent": { "type": "object" }
      },
      "required": ["key"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System audit and operational event logs",
      "type": "object",
      "properties": {
        "action": { "type": "string", "description": "Action performed" },
        "targetResource": { "type": "string", "description": "Target entity or resource type" },
        "targetId": { "type": "string", "description": "Resource identifier" },
        "details": { "type": "object", "description": "Contextual metadata and payload" },
        "performedBy": { "type": "object", "description": "User or operative who triggered the event" },
        "timestamp": { "type": "string", "description": "ISO date string" },
        "createdAt": { "type": "timestamp", "description": "Server creation timestamp" }
      },
      "required": ["action", "timestamp"]
    },
    "Log": {
      "title": "Log",
      "description": "Application and server event log stream",
      "type": "object",
      "properties": {
        "level": { "type": "string", "enum": ["info", "warn", "error", "security"], "description": "Log severity level" },
        "category": { "type": "string", "enum": ["auth", "system", "order", "catalog", "security"], "description": "Log category" },
        "message": { "type": "string", "description": "Human readable event message" },
        "action": { "type": "string", "description": "Action name" },
        "userId": { "type": "string", "description": "User identifier" },
        "userEmail": { "type": "string", "description": "User email address" },
        "ip": { "type": "string", "description": "Client IP address" },
        "userAgent": { "type": "string", "description": "Client user agent" },
        "metadata": { "type": "object", "description": "Context data" },
        "timestamp": { "type": "string", "description": "ISO timestamp" },
        "createdAt": { "type": "timestamp", "description": "Server creation timestamp" }
      },
      "required": ["level", "category", "message", "action", "timestamp"]
    },
    "AuthLog": {
      "title": "AuthLog",
      "description": "Authentication-specific audit event log",
      "type": "object",
      "properties": {
        "event": { "type": "string", "description": "Auth event type" },
        "email": { "type": "string", "description": "User email" },
        "userId": { "type": "string", "description": "User ID" },
        "role": { "type": "string", "description": "User role at event time" },
        "provider": { "type": "string", "description": "Auth provider" },
        "status": { "type": "string", "description": "Authentication status" },
        "failureReason": { "type": "string", "description": "Failure reason if applicable" },
        "ip": { "type": "string", "description": "Client IP" },
        "userAgent": { "type": "string", "description": "Client user agent" },
        "timestamp": { "type": "string", "description": "ISO timestamp" },
        "createdAt": { "type": "timestamp", "description": "Server creation timestamp" }
      },
      "required": ["event", "status", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Product catalog"
    },
    "/carts/{userId}": {
      "schema": { "$ref": "#/entities/Cart" },
      "description": "User carts"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/Setting" },
      "description": "System settings"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Audit logs"
    },
    "/logs/{logId}": {
      "schema": { "$ref": "#/entities/Log" },
      "description": "System event and operational logs"
    },
    "/auth_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuthLog" },
      "description": "Dedicated authentication event logs"
    }
  }
}
